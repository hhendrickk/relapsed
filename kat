local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local CurrentCamera = Workspace.CurrentCamera

local MouseLock = {
    Settings = {
        Prediction = 0.04,
        AimPart = 'HumanoidRootPart',
        Smoothing = 0.5,
        MaxDistance = 500,
    }
}

_G.MouseLockSettings = MouseLock.Settings

local RGB_SPEED = 0.3
local MOUSE_WEIGHT = 0.5

local isLocking = false
local isRightClickHeld = false
local scriptEnabled = false
local targetPlayer = nil
local lockConnection = nil
local highlightConnection = nil
local targetHighlight = nil

local button = script.Parent
if not button:IsA("GuiButton") then
    button = nil
end

local keybindValue = script:FindFirstChild("Keybind")
if not keybindValue then
    keybindValue = Instance.new("StringValue")
    keybindValue.Name = "Keybind"
    keybindValue.Value = "LeftBracket"
    keybindValue.Parent = script
end

local function GetCurrentKey()
    return Enum.KeyCode[keybindValue.Value] or Enum.KeyCode.LeftBracket
end
local isRightClickHeld = false

local function CreateHighlight()
    if targetHighlight then
        targetHighlight:Destroy()
    end
    
    targetHighlight = Instance.new("Highlight")
    targetHighlight.FillTransparency = 0.8
    targetHighlight.OutlineTransparency = 0.4
    targetHighlight.OutlineColor = Color3.new(1, 1, 1)
    
    return targetHighlight
end

local function UpdateHighlightColor()
    if targetHighlight and targetHighlight.Parent then
        local hue = (tick() * RGB_SPEED) % 1
        targetHighlight.FillColor = Color3.fromHSV(hue, 1, 1)
    end
end

local function FindClosestPlayer()
    local closestPlayer = nil
    local bestScore = math.huge
    
    local playerCharacter = LocalPlayer.Character
    if not playerCharacter then return nil end
    
    local playerRoot = playerCharacter:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return nil end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character then
                local humanoid = character:FindFirstChild("Humanoid")
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                
                if humanoid and humanoid.Health > 0 and rootPart then
                    local worldDistance = (rootPart.Position - playerRoot.Position).Magnitude
                    
                    if worldDistance <= MouseLock.Settings.MaxDistance then
                        local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(rootPart.Position)
                        
                        if onScreen then
                            local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                            local targetPos = Vector2.new(screenPos.X, screenPos.Y)
                            local mouseDistance = (targetPos - mousePos).Magnitude
                            
                            local normalizedMouseDist = mouseDistance / 1000
                            local normalizedWorldDist = worldDistance / MouseLock.Settings.MaxDistance
                            
                            local score = (normalizedMouseDist * MOUSE_WEIGHT) + 
                                         (normalizedWorldDist * (1 - MOUSE_WEIGHT))
                            
                            if score < bestScore then
                                closestPlayer = player
                                bestScore = score
                            end
                        end
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

local function IsTargetValid()
    if not targetPlayer then return false end
    if not targetPlayer.Character then return false end
    
    local humanoid = targetPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    local aimPart = targetPlayer.Character:FindFirstChild(MouseLock.Settings.AimPart)
    if not aimPart then return false end
    
    return true
end

local function AimAtTarget()
    if not isLocking or not IsTargetValid() or isRightClickHeld then
        return
    end
    
    local aimPart = targetPlayer.Character:FindFirstChild(MouseLock.Settings.AimPart)
    local predictedPosition = aimPart.Position + (aimPart.Velocity * MouseLock.Settings.Prediction)
    local screenPos = CurrentCamera:WorldToScreenPoint(predictedPosition)
    
    local deltaX = (screenPos.X - Mouse.X) * MouseLock.Settings.Smoothing
    local deltaY = (screenPos.Y - Mouse.Y) * MouseLock.Settings.Smoothing
    
    mousemoverel(deltaX, deltaY)
end

local function StartLock()
    if isLocking then return end
    
    targetPlayer = FindClosestPlayer()
    
    if targetPlayer and targetPlayer.Character then
        isLocking = true
        
        local highlight = CreateHighlight()
        highlight.Parent = targetPlayer.Character
        
        if not lockConnection then
            lockConnection = RunService.RenderStepped:Connect(AimAtTarget)
        end
        
        if not highlightConnection then
            highlightConnection = RunService.RenderStepped:Connect(UpdateHighlightColor)
        end
    end
end

local function StopLock()
    isLocking = false
    targetPlayer = nil
    
    if targetHighlight then
        targetHighlight:Destroy()
        targetHighlight = nil
    end
    
    if lockConnection then
        lockConnection:Disconnect()
        lockConnection = nil
    end
    
    if highlightConnection then
        highlightConnection:Disconnect()
        highlightConnection = nil
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not scriptEnabled then return end
    
    if input.KeyCode == GetCurrentKey() then
        StartLock()
    end
    
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRightClickHeld = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if not scriptEnabled then return end
    
    if input.KeyCode == GetCurrentKey() then
        StopLock()
    end
    
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isRightClickHeld = false
    end
end)

RunService.Heartbeat:Connect(function()
    if isLocking and not IsTargetValid() then
        StopLock()
    end
end)

if button then
    button.MouseButton1Click:Connect(function()
        scriptEnabled = not scriptEnabled
        
        if not scriptEnabled and isLocking then
            StopLock()
        end
    end)
end
